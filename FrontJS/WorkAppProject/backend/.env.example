# ---------------------------------------------------------------------------
# Copy to .env:   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me-3f8a1c9e7b2d4f6a8c0e1b3d5f7a9c1e"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=5001
NODE_ENV="development"

# The Vite dev server. Used for CORS and for links inside emails.
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# --- Email ---
# Leave MAIL_TRANSPORT=console in development: messages are printed to the
# terminal and the confirmation / reset link is returned in the API response
# (devLink), so you can test the whole flow without an SMTP server.
# Set it to "smtp" and fill in the SMTP_* values to send real email.
MAIL_TRANSPORT="console"
MAIL_FROM="Workx Clone <no-reply@workx.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Employer verification ---
# "auto"   -> a submitted request is approved immediately (handy for a demo)
# "manual" -> stays PENDING until reviewed via POST /api/verification/:id/review
VERIFICATION_MODE="manual"

# Email address that may review verification requests (acts as the admin).
ADMIN_EMAIL="admin@workx.local"
