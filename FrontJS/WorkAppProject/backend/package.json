{
  "name": "workx-clone-backend",
  "version": "2.0.0",
  "description": "Workx.am Clone - REST API (Express 5 + Prisma 7 + SQLite)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
    "seed": "tsx seed.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "setup": "prisma db push && tsx seed.js",
    "postinstall": "prisma generate"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
